fn leaf_settings(var kiln::Target& target, kiln::Options& options) {
	@target.option("standard", "c++latest");
	if (options.os() == "windows") {
		@target.option("runtime", "MT");
		if (options.profile() == "debug") {
			@target.option("runtime", "MTd");
		};
	};
	@target.option("includes", "include;modules;RutileGraphics/include");
	@target.package("glm");
};

fn leaf_packages(kiln::Options& options) {
	var glm = kiln::add_package("glm");
	@glm.option("headers", "glm/glm.hpp");
	if (options.os() == "windows") {
		@glm.option("libraries", "glm.lib");
	};
	var zip = kiln::add_package("libzip");
	@zip.option("pkgconfig", "libzip");
	if (options.os() == "windows") {
		@zip.option("link_options", "advapi32.lib;bcrypt.lib");
	};
	var lua = kiln::add_package("lua");
	@lua.option("headers", "lua.hpp");
	if (options.os() == "windows") {
		@lua.option("libraries", "lua.lib");
	}
	else {
		@lua.option("libraries", "liblua.a");
	};
	var sol = kiln::add_package("sol2");
	@sol.option("headers", "sol/sol.hpp");
	@sol.option("requires", "lua");
	var rml = kiln::add_package("rmlui");
	@rml.option("headers", "RmlUi/Core.h");
	if (options.os() == "windows") {
		@rml.option("libraries", "rmlui.lib;rmlui_debugger.lib");
	}
	else {
		@rml.option("libraries", "librmlui.a;librmlui_debugger.a");
	};
	@rml.option("requires", "freetype2");
	var stb = kiln::add_package("stb");
	@stb.option("headers", "stb_image.h");
	var magic = kiln::add_package("magic_enum");
	@magic.option("headers", "magic_enum/magic_enum.hpp");
	var audio = kiln::add_package("miniaudio");
	@audio.option("headers", "miniaudio.h");
	var checks = kiln::add_package("catch2-with-main");
	@checks.option("pkgconfig", "catch2-with-main");
	var runtime = kiln::add_package("leaf-runtime");
	@runtime.option("requires", "CLI11;yaml-cpp;glfw3;lua;sol2;rmlui;glm;libzip;stb;magic_enum;miniaudio;zlib");
	if (options.os() == "windows") {
		@runtime.option("link_options", "ws2_32.lib;advapi32.lib;bcrypt.lib;kernel32.lib;user32.lib;gdi32.lib;winspool.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;comdlg32.lib");
	}
	else {
		if (options.os() == "macos") {
			@runtime.option("link_options", "-pthread;-Wl,-framework,Cocoa;-Wl,-framework,IOKit;-Wl,-framework,CoreAudio;-Wl,-framework,AudioToolbox;-Wl,-framework,CoreFoundation");
		}
		else {
			@runtime.option("link_options", "-ldl;-pthread");
		};
	};
	if (options.value("storefront", "standalone") == "steam") {
		rt::string sdk = rt::environment("STEAMWORKS_SDK_DIR");
		if (sdk.empty()) {
			kiln::error("The Steam storefront requires STEAMWORKS_SDK_DIR.");
			return;
		};
		var steam = kiln::add_package("steamworks");
		@steam.option("prefix", sdk);
		@steam.option("include_directory", "public");
		@steam.option("headers", "steam/steam_api.h");
		if (options.os() == "windows") {
			@steam.option("library_directory", "redistributable_bin/win64");
			@steam.option("libraries", "steam_api64.lib");
			@steam.option("runtime_files", "redistributable_bin/win64/steam_api64.dll");
		}
		else {
			if (options.os() == "macos") {
				@steam.option("library_directory", "redistributable_bin/osx");
				@steam.option("libraries", "libsteam_api.dylib");
				@steam.option("runtime_files", "redistributable_bin/osx/libsteam_api.dylib");
			}
			else {
				@steam.option("library_directory", "redistributable_bin/linux64");
				@steam.option("libraries", "libsteam_api.so");
				@steam.option("runtime_files", "redistributable_bin/linux64/libsteam_api.so");
			};
		};
	};
};

fn build(kiln::Options& options) {
	leaf_packages(options);
	kiln::add_subdirectory("RutileGraphics");
	var core = kiln::add_target("leaf-core", kiln::TargetType::static_lib);
	leaf_settings(@core, options);
	@core.package("libzip");
	@core.package("yaml-cpp");
	@core.package("magic_enum");
	@core.depends_on("rutile");
	@core.sources.add("modules/core/dynamic_object.cpp");
	@core.sources.add("modules/core/error.cpp");
	@core.sources.add("modules/core/exception.cpp");
	@core.sources.add("modules/core/filesystem.cpp");
	@core.sources.add("modules/core/fixed.cpp");
	@core.sources.add("modules/core/logging.cpp");
	@core.sources.add("modules/core/package.cpp");
	@core.sources.add("modules/core/messages.cpp");
	@core.sources.add("modules/core/profiler.cpp");
	@core.sources.add("modules/core/progress.cpp");
	@core.sources.add("modules/core/random.cpp");
	@core.sources.add("modules/core/string.cpp");
	@core.sources.add("modules/core/time.cpp");
	@core.sources.add("modules/core/zip.cpp");

	var system = kiln::add_target("leaf-system", kiln::TargetType::static_lib);
	leaf_settings(@system, options);
	@system.depends_on("leaf-core");
	@system.sources.add("modules/system/crash_handler.cpp");
	if (options.os() == "windows") {
		@system.sources.add("modules/system/windows");
	}
	else {
		@system.sources.add("modules/system/posix");
	};

	var procedural = kiln::add_target("leaf-procedural", kiln::TargetType::static_lib);
	leaf_settings(@procedural, options);
	@procedural.depends_on("leaf-core");
	@procedural.sources.add("modules/procedural/scratch.cpp");

	var platform = kiln::add_target("leaf-platform", kiln::TargetType::static_lib);
	leaf_settings(@platform, options);
	@platform.package("glfw3");
	if (options.os() == "macos") {
		@platform.package("MoltenVK");
	};
	@platform.depends_on("leaf-core");
	@platform.depends_on("leaf-system");
	@platform.sources.add("modules/platform/desktop_glfw.cpp");

	var network = kiln::add_target("leaf-network", kiln::TargetType::static_lib);
	leaf_settings(@network, options);
	@network.depends_on("leaf-core");
	@network.depends_on("leaf-system");
	@network.sources.add("modules/network/peer.cpp");
	@network.sources.add("modules/network/channel.cpp");
	@network.sources.add("modules/network/socket.cpp");

	var lockstep = kiln::add_target("leaf-lockstep", kiln::TargetType::static_lib);
	leaf_settings(@lockstep, options);
	@lockstep.depends_on("leaf-core");
	@lockstep.depends_on("leaf-network");
	@lockstep.sources.add("modules/lockstep/session.cpp");
	@lockstep.sources.add("modules/lockstep/host.cpp");
	@lockstep.sources.add("modules/lockstep/remote.cpp");
	@lockstep.sources.add("modules/lockstep/protocol.cpp");

	var vendor = kiln::add_target("leaf-vendor", kiln::TargetType::static_lib);
	leaf_settings(@vendor, options);
	@vendor.package("stb");
	if (options.os() == "windows") {
		@vendor.option("compile_options", "/O2;/Ob2");
	}
	else {
		@vendor.option("compile_options", "-O2");
	};
	@vendor.sources.add("modules/vendor/stb_image.c");

	var graphics = kiln::add_target("leaf-graphics", kiln::TargetType::static_lib);
	leaf_settings(@graphics, options);
	@graphics.package("CLI11");
	@graphics.depends_on("leaf-core");
	@graphics.depends_on("leaf-platform");
	@graphics.depends_on("rutile");
	@graphics.sources.add("modules/graphics/antialias.cpp");
	@graphics.sources.add("modules/graphics/buffer.cpp");
	@graphics.sources.add("modules/graphics/command_buffer.cpp");
	@graphics.sources.add("modules/graphics/framebuffer.cpp");
	@graphics.sources.add("modules/graphics/graphics.cpp");
	@graphics.sources.add("modules/graphics/graphics_program.cpp");
	@graphics.sources.add("modules/graphics/queue.cpp");
	@graphics.sources.add("modules/graphics/resource.cpp");
	@graphics.sources.add("modules/graphics/rutile.cpp");
	@graphics.sources.add("modules/graphics/sampler.cpp");
	@graphics.sources.add("modules/graphics/swapchain.cpp");
	@graphics.sources.add("modules/graphics/timepoint.cpp");
	@graphics.sources.add("modules/graphics/texture.cpp");
	@graphics.sources.add("modules/graphics/texture_view.cpp");

	var manager = kiln::add_target("leaf-manager", kiln::TargetType::static_lib);
	leaf_settings(@manager, options);
	@manager.package("stb");
	@manager.depends_on("leaf-core");
	@manager.depends_on("leaf-graphics");
	@manager.depends_on("leaf-vendor");
	@manager.sources.add("modules/manager/texture_atlas.cpp");
	@manager.sources.add("modules/manager/asset.cpp");

	var script = kiln::add_target("leaf-script", kiln::TargetType::static_lib);
	leaf_settings(@script, options);
	@script.package("sol2");
	@script.package("stb");
	@script.package("magic_enum");
	@script.depends_on("leaf-core");
	@script.depends_on("leaf-manager");
	@script.sources.add("modules/script/localization.cpp");
	@script.sources.add("modules/script/mod_enabled.cpp");
	@script.sources.add("modules/script/mod_info.cpp");
	@script.sources.add("modules/script/mod_loader.cpp");
	@script.sources.add("modules/script/prototype.cpp");
	@script.sources.add("modules/script/cursor.cpp");
	@script.sources.add("modules/script/sound.cpp");
	@script.sources.add("modules/script/state.cpp");
	@script.sources.add("modules/script/interfaces.cpp");
	@script.sources.add("modules/script/shader.cpp");
	@script.sources.add("modules/script/texture.cpp");

	var audio = kiln::add_target("leaf-audio", kiln::TargetType::static_lib);
	leaf_settings(@audio, options);
	@audio.package("miniaudio");
	@audio.package("sol2");
	@audio.depends_on("leaf-core");
	@audio.depends_on("leaf-script");
	@audio.sources.add("modules/audio/audio.cpp");
	@audio.sources.add("modules/audio/miniaudio.c");
	@audio.sources.add("modules/audio/script.cpp");

	var application = kiln::add_target("leaf-application", kiln::TargetType::static_lib);
	leaf_settings(@application, options);
	@application.package("rmlui");
	@application.package("sol2");
	@application.package("stb");
	@application.depends_on("leaf-core");
	@application.depends_on("leaf-system");
	@application.depends_on("leaf-platform");
	@application.depends_on("leaf-graphics");
	@application.depends_on("leaf-network");
	@application.depends_on("leaf-script");
	@application.depends_on("leaf-audio");
	@application.depends_on("leaf-vendor");
	@application.depends_on("rtslc");
	@application.sources.add("modules/application/shaders/application.rtsl");
	@application.option("rtsl_compiler", "{artifact:rtslc}");
	@application.option("rtsl_module", "application");
	@application.option("rtsl_symbol", "leaf_application_shader");
	@application.option("rtsl_header", "leaf/graphics/graphics_program.hpp");
	@application.option("rtsl_type", "rt::program_bytes");
	@application.sources.add("modules/application/rml/backend.cpp");
	@application.sources.add("modules/application/rml/cast_shadow.cpp");
	@application.sources.add("modules/application/rml/context.cpp");
	@application.sources.add("modules/application/rml/file_interface.cpp");
	@application.sources.add("modules/application/rml/render_interface.cpp");
	@application.sources.add("modules/application/rml/system_interface.cpp");
	@application.sources.add("modules/application/scene.cpp");
	@application.sources.add("modules/application/window.cpp");

	var progression = kiln::add_target("leaf-progression", kiln::TargetType::static_lib);
	leaf_settings(@progression, options);
	@progression.depends_on("leaf-core");
	@progression.sources.add("modules/progression/progression.cpp");

	var store = kiln::add_target("leaf-store", kiln::TargetType::static_lib);
	leaf_settings(@store, options);
	@store.depends_on("leaf-core");
	@store.depends_on("leaf-progression");
	@store.sources.add("modules/store/progression.cpp");
	var storefront = options.value("storefront", "standalone");
	if (storefront == "steam") {
		@store.package("steamworks");
		@store.depends_on("leaf-network");
		@store.sources.add("modules/store/steam");
	}
	else {
		if (storefront != "standalone") {
			kiln::error("Storefront must be standalone or steam.");
			return;
		};
		@store.sources.add("modules/store/none");
	};

	var framework = kiln::add_target("leaf-framework", kiln::TargetType::static_lib);
	leaf_settings(@framework, options);
	@framework.package("rmlui");
	@framework.package("sol2");
	@framework.depends_on("leaf-application");
	@framework.depends_on("leaf-lockstep");
	@framework.depends_on("leaf-progression");
	@framework.depends_on("leaf-store");
	@framework.sources.add("modules/framework/leaf.cpp");
};
